# FastAPI Server Environment Config
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Credentials (SERVER-SIDE ONLY)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Security Encryption Key (AES-256-GCM 32 bytes hex)
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ClamAV Antivirus Scanner (Feature flag)
ENABLE_CLAMAV_SCAN=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Logistics Rate Calculator Defaults
OSRM_ENDPOINT=https://router.project-osrm.org
PER_KM_TON_RATE=4.50
BASE_TRANSPORT_FARE=1200.00
